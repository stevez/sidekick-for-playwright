{
  "manifest_version": 3,
  "name": "Sidekick for Playwright – Test Recorder, Debugger & Video",
  "short_name": "Sidekick for Playwright",
  "version": "1.0.1",
  "description": "Record once — get the Playwright test and the video. Record, pick locators, and run or debug Playwright JavaScript in a side panel.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sidekick for Playwright",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
