{
  "name": "sidekick-for-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Sidekick for Playwright — Chrome extension to record Playwright tests, pick locators, run and debug scripts, and record video",
  "license": "MIT",
  "author": "Steve Zhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevez/sidekick-for-playwright.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@lezer/highlight": "^1.2.3",
    "@playwright-repl/playwright-crx": "^1.22.1",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.1.1",
    "mediabunny": "1.62.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/chrome": "^0.0.304",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "~4.0.18"
  }
}
